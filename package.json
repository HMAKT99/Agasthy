{
  "name": "agasthy",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agasthy/desktop tauri dev",
    "build": "pnpm --filter @agasthy/desktop tauri build",
    "tauri": "pnpm --filter @agasthy/desktop tauri",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @agasthy/desktop e2e",
    "e2e:setup": "pnpm --filter @agasthy/desktop e2e:setup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "release:mac": "bash scripts/release-mac.sh",
    "screenshots": "pnpm --filter @agasthy/desktop exec playwright test -c playwright.demo.config.ts",
    "demo:video": "pnpm screenshots && pnpm --filter @agasthy/demo-video render && pnpm --filter @agasthy/demo-video gif"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.6.7"
    }
  }
}
