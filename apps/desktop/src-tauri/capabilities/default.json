{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: AGASTHY's own commands (reads, plus plan/execute for typed, re-validated, audited actions), the folder picker and reveal-in-file-manager. Nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    "allow-app-info",
    "allow-telemetry",
    "allow-gpus",
    "allow-overview",
    "allow-list-scan-roots",
    "allow-add-scan-root",
    "allow-remove-scan-root",
    "allow-set-scan-root-enabled",
    "allow-run-scan",
    "allow-running-scans",
    "allow-list-entities",
    "allow-entity-detail",
    "allow-list-scans",
    "allow-list-audit",
    "allow-graph-neighborhood",
    "allow-graph-overview",
    "allow-runtime-impact",
    "allow-shared-dependencies",
    "allow-list-edges",
    "allow-processes",
    "allow-disk-analysis",
    "allow-cached-disk-analysis",
    "allow-quarantine-list",
    "allow-plan-action",
    "allow-execute-action",
    "allow-removal-impact",
    "allow-snapshots-list",
    "allow-snapshot-create",
    "allow-snapshot-compare",
    "allow-snapshot-reconstruction",
    "allow-security-settings",
    "allow-set-osv-enabled",
    "allow-labs-list",
    "allow-operator-settings",
    "allow-operator-set-provider",
    "allow-operator-set-key",
    "allow-operator-delete-key",
    "allow-operator-set-cloud-consent",
    "allow-operator-ask",
    "allow-agent-report",
    "allow-agent-worktrees",
    "allow-agent-usage",
    "allow-insights",
    "allow-scan-schedule",
    "allow-set-auto-refresh",
    "updater:default",
    "process:allow-restart",
    "allow-diagnostics-report",
    "allow-open-issue",
    "allow-open-releases",
    "allow-export-usage-csv"
  ]
}
