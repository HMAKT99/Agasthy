{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AGASTHY",
  "version": "0.1.7",
  "identifier": "org.agasthy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AGASTHY",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Developer machine intelligence",
    "copyright": "The AGASTHY Authors",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwOUNDRTlENjYzQUE3NzcKUldSM3B6cG1uYzZjb0JYNnlZUTRZVW9rTmN3QW5LVjE4SXhNZXRqb09TdFV5bjF5Z1Y5VG1BdGIK",
      "endpoints": [
        "https://github.com/HMAKT99/Agasthy/releases/latest/download/latest.json"
      ]
    }
  }
}
