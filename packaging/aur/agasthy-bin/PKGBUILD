# Maintainer: Arun Kumar Thiagarajan (HMAKT99) <https://github.com/HMAKT99>
#
# Repackages the official release: the desktop app from the .deb and the
# `agasthy` command-line tool (CLI and read-only MCP server) from its tarball.
# Checksums are the ones published next to each release asset.

pkgname=agasthy-bin
pkgver=0.1.10
pkgrel=1
pkgdesc="Maps a developer machine: repos, runtimes, packages, coding agents, MCP servers and what breaks if you remove something"
arch=('x86_64' 'aarch64')
url="https://github.com/HMAKT99/Agasthy"
license=('Apache-2.0')
# libayatana-appindicator is loaded at run time for the tray icon, so namcap
# cannot see it.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus'
         'libayatana-appindicator' 'hicolor-icon-theme' 'glibc' 'libgcc')
provides=('agasthy')
conflicts=('agasthy')
options=('!strip' '!debug')

_rel="https://github.com/HMAKT99/Agasthy/releases/download/v${pkgver}"
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/HMAKT99/Agasthy/v${pkgver}/LICENSE")
source_x86_64=("${_rel}/agasthy_${pkgver}_amd64.deb"
               "agasthy-cli-${pkgver}-x86_64.tar.gz::${_rel}/agasthy-cli-linux-x86_64.tar.gz")
source_aarch64=("${_rel}/agasthy_${pkgver}_arm64.deb"
                "agasthy-cli-${pkgver}-aarch64.tar.gz::${_rel}/agasthy-cli-linux-aarch64.tar.gz")
noextract=("agasthy_${pkgver}_amd64.deb" "agasthy_${pkgver}_arm64.deb")
sha256sums=('SKIP')
sha256sums_x86_64=('9f38af58cd89f34e74aaefa3860cf9522148c4e833a7c9358bda0b964fdc8670'
                   '44d6a7b8afa09c20b24e8fe3d2d04066ee5a198b7c30c794cef822a5d91c4d7c')
sha256sums_aarch64=('741e835e5323f055bee9246267b52929d3fc048910a906face152d0a4c0fb40a'
                    'f11c73a3878656c2c4f799319ebc059d4e12c641b3a69d066d17a12cc4879880')

prepare() {
  local _deb
  case "$CARCH" in
    x86_64) _deb="agasthy_${pkgver}_amd64.deb" ;;
    aarch64) _deb="agasthy_${pkgver}_arm64.deb" ;;
  esac
  rm -rf deb && mkdir deb
  bsdtar -xf "$_deb" -C deb data.tar.gz
  bsdtar -xf deb/data.tar.gz -C deb
}

package() {
  install -Dm755 deb/usr/bin/agasthy-desktop "$pkgdir/usr/bin/agasthy-desktop"
  install -Dm644 deb/usr/share/applications/AGASTHY.desktop "$pkgdir/usr/share/applications/AGASTHY.desktop"
  local _icon
  for _icon in deb/usr/share/icons/hicolor/*/apps/agasthy-desktop.png; do
    install -Dm644 "$_icon" "$pkgdir/${_icon#deb/}"
  done
  install -Dm755 agasthy "$pkgdir/usr/bin/agasthy"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
